# Exemplo de .env para LukaMagicBOT
# Copie este arquivo para `.env` e ajuste os valores antes de rodar em produção.

# -----------------------------
# Básico do Bot / App
# -----------------------------
# Token do bot Telegram (obrigatório)
BOT_TOKEN=

# URL pública para webhook (ex.: https://meu-app.example). Se usar polling, deixe vazio e defina LOCAL_POLLING=1
PUBLIC_URL=

# Use polling local em vez de webhook (1 ou 0)
LOCAL_POLLING=0

# Porta do servidor FastAPI
PORT=8080

# -----------------------------
# Admin / painel
# -----------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Secret para SessionMiddleware (troque por algo forte em produção)
ADMIN_SECRET=change-this-admin-secret

# -----------------------------
# Banco de dados
# -----------------------------
# Exemplo SQLite local (padrão). Em produção, prefira Postgres (ex.: postgres://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./lukabot.db

# -----------------------------
# Stripe (opcional)
# -----------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mapear price ids (opcional)
PRICE_MONTHLY_ID=
PRICE_QUARTERLY_ID=
PRICE_ANNUAL_ID=

# -----------------------------
# Auto-removal / scheduler
# -----------------------------
# Habilita scheduler de remoções automáticas (1 = sim, 0 = não)
ENABLE_AUTO_REMOVAL=1

# Hora do dia para execução do cleanup (0-23)
CLEANUP_TIME=2
# Hora do dia para notificações de expiração
NOTIFICATION_TIME=10
# Dias de período de graça antes de remover
GRACE_PERIOD_DAYS=3
# Modo de teste (jobs de teste mais frequentes)
CLEANUP_TEST_MODE=0
# Habilita avisos de expiração
ENABLE_EXPIRY_NOTIFICATIONS=1

# Timezone para scheduler (ex.: Europe/Lisbon)
TZ=UTC

# -----------------------------
# VIP / convites
# -----------------------------
# Link de fallback para VIP (opcional)
VIP_INVITE_LINK=
# IDs de grupos VIP separados por vírgula (ex.: -100123,-100456)
VIP_GROUP_IDS=

# Cooldown em segundos para geração de convites
INVITE_COOLDOWN_SECONDS=180

# -----------------------------
# Service Cleanup (opcional - também editável pelo painel Admin)
# -----------------------------
# Nota: o sistema persiste estas chaves na tabela `settings` quando alteradas pelo painel.
# Você pode usar estas variáveis como overrides iniciais.
service_cleanup.enabled=false
service_cleanup.remove_on_join=true
service_cleanup.remove_on_leave=true
service_cleanup.forward_target_id=

# -----------------------------
# Outros
# -----------------------------
# Se necessário, adicione aqui outras flags e segredos.

# Segurança: não comite o arquivo .env final com segredos para repositórios públicos.